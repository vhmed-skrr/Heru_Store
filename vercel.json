{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/shop", "destination": "/shop.html" },
    { "source": "/product", "destination": "/product.html" },
    { "source": "/cart", "destination": "/cart.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/confirmation", "destination": "/confirmation.html" },
    { "source": "/track-order", "destination": "/track-order.html" },
    { "source": "/suggest", "destination": "/suggest.html" },
    { "source": "/review", "destination": "/review.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/about-story", "destination": "/about-story.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/admin/add-product", "destination": "/admin/add-product.html" },
    { "source": "/admin/edit-product", "destination": "/admin/edit-product.html" },
    { "source": "/admin/add-category", "destination": "/admin/add-category.html" },
    { "source": "/admin/edit-category", "destination": "/admin/edit-category.html" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": ".*", "status": 404, "dest": "/404.html" }
  ]
}
